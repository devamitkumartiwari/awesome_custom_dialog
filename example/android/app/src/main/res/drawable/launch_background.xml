<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: brand teal with the ACD mark in the centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF115E59"
                android:startColor="#FF0D9488"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
